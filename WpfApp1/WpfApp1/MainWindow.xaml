<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
       Title="Puesto ABN - Control de Asistencia"
        Height="700" Width="480"
        Background="#1a1a1a"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#922B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#C0392B" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="36" Height="36" Fill="#922B21" Margin="0,0,10,0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#C0392B" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PUESTO ABN" FontFamily="Segoe UI Black" FontSize="16" Foreground="White"/>
                    <TextBlock Text="Sistema de Control de Asistencia" FontFamily="Segoe UI" FontSize="10" Foreground="#FFCDD2"/>
                </StackPanel>
                <!-- Live indicator -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#4CAF50" Margin="0,0,5,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.2" Duration="0:0:0.8"
                                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="LiveLabel" Text="EN VIVO" FontFamily="Segoe UI Semibold" FontSize="10" Foreground="#4CAF50"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Camera View -->
        <Border Grid.Row="1" Background="#0d0d0d" Margin="0">
            <Grid>
                <!-- Camera Image -->
                <Image x:Name="CameraImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- No camera placeholder -->
                <StackPanel x:Name="NoCameraPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📷" FontSize="60" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="Cámara no iniciada" FontFamily="Segoe UI" FontSize="14" 
                               Foreground="#555" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Presione INICIAR CÁMARA" FontFamily="Segoe UI" FontSize="11" 
                               Foreground="#444" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Info Overlay Bar (like in the photos) -->
        <Border Grid.Row="2" Background="#CC1C1C1C">
            <Border Background="#DD000000" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Puesto ABN title bold -->
                        <TextBlock x:Name="TxtPuesto" 
                                   Text="Puesto ABN"
                                   FontFamily="Segoe UI Black" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <!-- Date and time -->
                        <TextBlock x:Name="TxtDateTime" 
                                   Text="2 may 2026 7:03:50"
                                   FontFamily="Segoe UI" 
                                   FontSize="13"
                                   Foreground="#CCCCCC"
                                   Margin="0,2,0,0"/>

                        <!-- Address line 1 -->
                        <TextBlock x:Name="TxtAddress1" 
                                   Text="Avenida Capitán Víctor Ustáriz Quillacollo"
                                   FontFamily="Segoe UI" 
                                   FontSize="12"
                                   Foreground="#AAAAAA"
                                   Margin="0,1,0,0"/>

                        <!-- Address line 2 -->
                        <TextBlock x:Name="TxtAddress2" 
                                   Text="Departamento de Cochabamba"
                                   FontFamily="Segoe UI" 
                                   FontSize="12"
                                   Foreground="#AAAAAA"/>
                    </StackPanel>

                    <!-- ABN Logo area -->
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="4"
                            Background="#C0392B" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="ABN" FontFamily="Segoe UI Black" FontSize="12" 
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="3" Background="#222" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnStart" Content="▶ INICIAR" 
                        Style="{StaticResource ModernButton}"
                        Click="BtnStart_Click"/>

                <Button Grid.Column="2" x:Name="BtnCapture" Content="📷 CAPTURAR"
                        Style="{StaticResource ModernButton}"
                        Background="#2C3E50"
                        Click="BtnCapture_Click"
                        IsEnabled="False"/>

                <Button Grid.Column="4" x:Name="BtnStop" Content="⏹ DETENER"
                        Style="{StaticResource ModernButton}"
                        Background="#555"
                        Click="BtnStop_Click"
                        IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
